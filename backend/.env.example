# ==========================================
# POS System - Production Environment Configuration
# ==========================================

# Port for the Node.js API server
PORT=3001

# Application environment ('production' or 'development')
# In 'production', cookies require HTTPS (secure: true)
NODE_ENV=production

# JWT Secret Key (generate a strong random 32+ character string in production)
JWT_SECRET=pos_ultra_secure_jwt_secret_key_change_me_in_prod_2026

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# Example: https://pos.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Cookie Settings
# 'lax' if frontend and backend share the same domain/subdomain
# 'none' if frontend and backend are on different domains (requires HTTPS)
COOKIE_SAMESITE=lax

# Optional Cookie Domain (e.g. .yourdomain.com to share cookie across subdomains)
# COOKIE_DOMAIN=.yourdomain.com

# Database Configuration:
# - PostgreSQL (Cloud / Remote / Multi-Device Sync):
#   Example (Render / Supabase / Neon / Local):
#   DATABASE_URL=postgresql://postgres:your_password@ep-cool-db.us-east-2.aws.neon.tech/pos_db?sslmode=require
# - SQLite (Local Offline / Desktop App fallback when DATABASE_URL is empty):
#   DB_PATH=./pos.db
# DATABASE_URL=
DB_PATH=./pos.db
DATABASE_SSL=true
